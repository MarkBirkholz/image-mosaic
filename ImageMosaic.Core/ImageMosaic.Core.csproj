<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF is used only for its imaging stack (WIC): fast scaled JPEG decoding and encoding. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>ImageMosaic.Core</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageMosaic.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interface texts, one file per language; copied next to every program that uses the core. -->
    <None Include="..\Languages\*.json" Link="Languages\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
